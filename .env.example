# Environment
DJANGO_ENV=dev
DEBUG=true
SECRET_KEY=dev-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# DATABASE_URL=postgres://user:password@localhost:5432/salonix
DATABASE_URL=sqlite:///db.sqlite3

# CORS & CSRF
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security (Staging/Prod)
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SAMESITE=None

# Client PWA
CLIENT_PWA_INVITE_TTL_SECONDS=900
CLIENT_PWA_SESSION_TTL_SECONDS=3888000

# Observability
OBSERVABILITY_ENABLED=true

# Testing
SMOKE_USER_PASSWORD=Smoke@123

# Captcha (django-simple-captcha)
CAPTCHA_ENABLED=false
CAPTCHA_BYPASS_TOKEN=bypass-token-for-tests

# Celery (BE-ACCOUNT-CANCEL #396)
CELERY_BROKER_URL=redis://localhost:6379/0
BACKUP_ROOT=./backups

# Email (BE-EMAIL-01 / BE-MARKETING-02 #477)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=TimelyOne <timelyone@timelyone.today>
# EMAIL_REPLY_TO=support@timelyone.today
# Remetente por tipo de email — nao mudar os defaults sem decisao de produto:
# EMAIL_FROM_BOOKING=TimelyOne <booking@timelyone.today>
# EMAIL_FROM_CANCELLATION=TimelyOne <cancellation@timelyone.today>
# EMAIL_FROM_SUPPORT=TimelyOne <support@timelyone.today>
# EMAIL_FROM_BILLING=TimelyOne <billing@timelyone.today>
